using bit vectors;
using variables;
using maths;
using comparisons;

make number variables up to 1000;

#upper_limit = _ONE_THOUSAND + _ONE_THOUSAND;
upper_limit = _TEN;

sieve: bit vector;
sieve = _THREE;
# 3 == 0b...011 = [1, 1, 0, ...]

clear index;
incr index;
incr index;
gap_between_index_and_upper_limit = upper_limit - index;
while gap_between_index_and_upper_limit not 0 do;
    is_index_composite = sieve[index];
    is_index_prime = not is_index_composite;
    while is_index_prime not 0 do;
        print index;
        multiple_of_index = index;
        times_to_increase_the_multiple r _ = upper_limit / index;
        while times_to_increase_the_multiple not 0 do;
            #print multiple_of_index;
            sieve[multiple_of_index] = 1;
            multiple_of_index += index;
            decr times_to_increase_the_multiple;
        end;
        clear is_index_prime;
    end;
    incr index;
    decr gap_between_index_and_upper_limit;
end;

# This program is by necessity very slow, due to the number of incrs required
# For example, with an upper_limit L, it takes 2^3 + 2^5 + 2^7 + ... + 2^L = 2/3 (4^ceil(L/2) - 4) incrs just to be able to check if 3 is prime
